# ---------- ЭТАП 1: сборка фронта (admin + dashboard) ----------
FROM node:20-alpine AS fe-build

# Немного утилит
RUN apk add --no-cache bash git
RUN corepack enable || true

# --- ADMIN ---
WORKDIR /src/web/admin
COPY web/admin/package*.json ./
RUN npm ci
RUN npm i -g @angular/cli
COPY web/admin/ ./
RUN ng build --output-path /out/admin

# --- DASHBOARD ---
WORKDIR /src/web/dashboard
COPY web/dashboard/package*.json ./
RUN npm ci
COPY web/dashboard/ ./
RUN ng build --output-path /out/dashboard

# ---------- ЭТАП 2: финальный образ Nginx ----------
FROM nginx:latest

# 0) Чистим дефолтный конфиг из базового образа (важно)
RUN rm -f /etc/nginx/conf.d/default.conf || true

# 1) Копируем твои конфиги виртуальных хостов (*.conf обязательно)
COPY nginx/conf/ /etc/nginx/conf.d/

# 2) Кладём собранные SPA-бандлы
COPY --from=fe-build /out/ /var/www/sites/

# 3) Подстраховка: минимальный дефолтный сервер и /health
#    (не конфликтует с именными vhost'ами admin.labserver.local и т.д.)
RUN printf "server {\n\
  listen 80;\n\
  server_name _;\n\
  location /health { return 200 'ok'; add_header Content-Type text/plain; }\n\
}\n" > /etc/nginx/conf.d/000-default.conf

# По желанию:
# EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
